NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=GiaLaiTravel
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=10000
DB_SSL=false

# Optional auth: generate local keys with npm run auth:keys -w be, then enable.
AUTH_ENABLED=false
AUTH_KEY_ID=local-dev-v1
AUTH_PRIVATE_KEY_FILE=.local/auth/private.pem
AUTH_ISSUER=gialai-travel-api
AUTH_AUDIENCE=gialai-travel-web
# Secure is mandatory/default in production; false is for local HTTP only.
# AUTH_COOKIE_SECURE=false
# AUTH_PREVIOUS_PUBLIC_KEYS_FILE=/absolute/path/to/public-keyring.json

# Optional Cloudflare R2 object storage for media and banner uploads
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=gialai-travel
# R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# AI Smart Itinerary Planner (OpenAI / Google Gemini API)
# AI_PROVIDER=auto
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Migration writes require separate DDL credentials (never filled by default).
# MIGRATION_DB_USER=
# MIGRATION_DB_PASSWORD=
