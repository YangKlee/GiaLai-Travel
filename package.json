{
  "name": "gialai-travel",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["be", "fe"],
  "engines": { "node": "20.20.2" },
  "scripts": {
    "dev": "concurrently -k -n be,fe \"npm run dev -w be\" \"npm run dev -w fe\"",
    "dev:demo": "concurrently -k -n be,fe \"npm run dev:demo -w be\" \"npm run dev -w fe\"",
    "dev:be": "npm run dev -w be",
    "dev:fe": "npm run dev -w fe",
    "start": "npm run start -w be",
    "build": "npm run build -w fe",
    "lint": "npm run lint -w fe",
    "test": "npm run test:be && npm run test:fe",
    "test:be": "npm run test -w be",
    "test:fe": "npm run test -w fe",
    "test:e2e": "npm run test:e2e -w fe"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
